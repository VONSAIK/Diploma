# Google Gemini API (https://aistudio.google.com/app/apikey — безкоштовно)
GEMINI_API_KEY=your_gemini_api_key_here

# NewsAPI (https://newsapi.org — безкоштовний план)
NEWS_API_KEY=your_newsapi_key_here

# PostgreSQL (замінити user/password/investment_db на свої)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/investment_db

# Довільний рядок для підпису JWT токенів
SECRET_KEY=your_secret_key_here

# Режим розробки
DEBUG=true
